   "DisambiguationSettings": {
    "description": "How a builder session merges extracted instances of a class that name the same entity\n(builder/disambiguate.py). The modes form a chain, each adds a step to the previous ones:\n\n- ``off``: an instance per IRI slug (so case and punctuation variants still meet),\n- ``normalized``: names equal after case folding and whitespace/punctuation normalization,\n- ``levenshtein``: also names within ``max_distance`` edits (and ``max_ratio`` of the longer name),\n- ``llm_judge``: also the ``judge_candidates`` closest names (char n-gram TF-IDF, cosine at\n  least ``judge_min_similarity``) that the judge model says are the same entity (its\n  P(yes) of a yes/no answer at least ``judge_threshold``).",
    "properties": {
     "judge_candidates": {
      "default": 1,
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Judge Candidates",
      "type": "integer"
     },
     "judge_min_similarity": {
      "default": 0.4,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Judge Min Similarity",
      "type": "number"
     },
     "judge_threshold": {
      "default": 0.65,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Judge Threshold",
      "type": "number"
     },
     "max_distance": {
      "default": 2,
      "maximum": 20.0,
      "minimum": 0.0,
      "title": "Max Distance",
      "type": "integer"
     },
     "max_ratio": {
      "default": 0.2,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Max Ratio",
      "type": "number"
     },
     "mode": {
      "default": "normalized",
      "enum": [
       "off",
       "normalized",
       "levenshtein",
       "llm_judge"
      ],
      "title": "Mode",
      "type": "string"
     }
    },
    "title": "DisambiguationSettings",
    "type": "object"
   },
