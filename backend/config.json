      "description": "GutBrainIE biomedical relation-extraction corpus.",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset-gutbrainie-test",
      "sparql_endpoint": "http://${GUTBRAINIE_SPARQL_ENDPOINT:-localhost}:9101",
