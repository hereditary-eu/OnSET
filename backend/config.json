    "dblp": {
      "name": "DBLP Dump",
      "description": "DBLP computer science bibliography dump.",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset-dblp",
      "sparql_endpoint": "http://${DBLP_SPARQL_ENDPOINT:-localhost}:9601",
