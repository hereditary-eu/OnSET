{
  "default": "${ONSET_DEFAULT_CONFIG:-dbpedia}",
  "defaults": {
    "model_id": "${LLM_MODEL_ID:-NousResearch/Hermes-3-Llama-3.2-3B-GGUF}",
    "model_quant": "${LLM_MODEL_QUANT:-*Q8_0.gguf}",
    "device": "${LLM_DEVICE:-cuda}",
    "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset",
    "sparql_endpoint": "${ONSET_SPARQL_ENDPOINT:-http://localhost:7012}",
    "redis_cache_url": "${REDIS_CACHE_URL:-redis://localhost:6379/1}",
    "selection_distribution": "instances",
    "agent": {
      "base_url": "${AGENT_LLM_BASE_URL:-https://hereditary.cgv.tugraz.at/lm-large/api/v1}",
      "api_key": "${AGENT_LLM_API_KEY:-none}",
      "model": "${AGENT_LLM_MODEL:-}"
    },
    "progressive": {
      "timeout": "${ONSET_PROGRESSIVE_TIMEOUT:-10}",
      "parallelism": "${ONSET_PROGRESSIVE_PARALLELISM:-4}",
      "default_sample_size": "${ONSET_PROGRESSIVE_DEFAULT_SAMPLE_SIZE:-2048}",
      "count_limit": "${ONSET_PROGRESSIVE_COUNT_LIMIT:-1000000}",
      "server_timeout": "${ONSET_PROGRESSIVE_SERVER_TIMEOUT:-true}",
      "sample_constraints": "${ONSET_PROGRESSIVE_SAMPLE_CONSTRAINTS:-false}",
      "constraint_sample_size": "${ONSET_PROGRESSIVE_CONSTRAINT_SAMPLE_SIZE:-}",
      "numeric_percentiles": "${ONSET_PROGRESSIVE_NUMERIC_PERCENTILES:-10,25,50,75,90}",
      "categorical_samples": "${ONSET_PROGRESSIVE_CATEGORICAL_SAMPLES:-}",
      "max_categorical_values": "${ONSET_PROGRESSIVE_MAX_CATEGORICAL_VALUES:-50}",
      "min_category_count": "${ONSET_PROGRESSIVE_MIN_CATEGORY_COUNT:-2}",
      "max_numeric_values": "${ONSET_PROGRESSIVE_MAX_NUMERIC_VALUES:-10000}",
      "max_depth": "${ONSET_PROGRESSIVE_MAX_DEPTH:-3}",
      "default_branching": "${ONSET_PROGRESSIVE_DEFAULT_BRANCHING:-4}",
      "max_branching": "${ONSET_PROGRESSIVE_MAX_BRANCHING:-16}",
      "child_sample_size": "${ONSET_PROGRESSIVE_CHILD_SAMPLE_SIZE:-}",
      "child_constraint_sample_size": "${ONSET_PROGRESSIVE_CHILD_CONSTRAINT_SAMPLE_SIZE:-}",
      "max_total_queries": "${ONSET_PROGRESSIVE_MAX_TOTAL_QUERIES:-400}"
    }
  },
  "configs": {
    "dbpedia": {
      "name": "DBpedia",
      "description": "DBpedia knowledge graph with multimodal (CLIP) thumbnail embeddings.",
      "save_named_individuals": false,
      "sparql_endpoint": "${DBPEDIA_SPARQL_ENDPOINT:-http://localhost:7012}",
      "ontology_extension": [
        "@prefix owl: <http://www.w3.org/2002/07/owl#> .",
        "@prefix dbo: <http://dbpedia.org/ontology/> .",
        "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .",
        "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .",
        "",
        "dbo:thumbnail_embedding\trdf:type\towl:FunctionalProperty ,",
        "\t\towl:DatatypeProperty .",
        "dbo:thumbnail_embedding\trdfs:label\t\"thumbnail embedding\"@en ;",
        "    \trdfs:domain\towl:Thing ;",
        "        rdfs:range\t<https://w3id.org/rdf-tensor/datatypes#NumericDataTensor> ."
      ],
      "additional_namespaces": {
        "dbo": "http://dbpedia.org/ontology/"
      },
      "multimodal_config": {
        "encoding_model": "clip-ViT-B-32",
        "image_vector_properties": [
          "dbo:thumbnail_embedding"
        ],
        "image_properties": [
          "dbo:thumbnail"
        ],
        "image_types": [
          "dbo:Image"
        ]
      },
      "variants": [
        {
          "name": "DBpedia Mistral",
          "model_id": "bartowski/Mistral-Small-Instruct-2409-GGUF",
          "model_quant": "*-Q6_K.gguf"
        },
        {
          "name": "DBpedia Qwen2.5 Coder 32B",
          "model_id": "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "DBpedia Qwen2.5 Coder 32B",
          "model_id": "bartowski/Qwen2.5-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "DBpedia large",
          "model_id": "NousResearch/Hermes-3-Llama-3.1-8B-GGUF"
        }
      ]
    },
    "oma": {
      "name": "OMA",
      "description": "Orthologous MAtrix (OMA) browser data.",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset-uniprot",
      "sparql_endpoint": "${OMA_SPARQL_ENDPOINT:-http://localhost:7013}",
      "selection_distribution": "uniform",
      "variants": [
        {
          "name": "OMA Mistral",
          "model_id": "bartowski/Mistral-Small-Instruct-2409-GGUF",
          "model_quant": "*-Q6_K.gguf"
        },
        {
          "name": "OMA Mistral",
          "model_id": "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "OMA Mistral",
          "model_id": "bartowski/Qwen2.5-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "OMA large",
          "model_id": "NousResearch/Hermes-3-Llama-3.1-8B-GGUF"
        }
      ]
    },
    "uniprot": {
      "name": "UniProt",
      "description": "UniProt protein knowledge base.",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset-uniprot",
      "sparql_endpoint": "${UNIPROT_SPARQL_ENDPOINT:-http://localhost:7014}",
      "selection_distribution": "uniform",
      "variants": [
        {
          "name": "UniProt Mistral",
          "model_id": "bartowski/Mistral-Small-Instruct-2409-GGUF",
          "model_quant": "*-Q6_K.gguf"
        },
        {
          "name": "UniProt Mistral",
          "model_id": "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
