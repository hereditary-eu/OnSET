          "model_quant": "*-Q6_K.gguf"
        },
        {
          "name": "DNB Mistral",
          "model_id": "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "DNB Mistral",
          "model_id": "bartowski/Qwen2.5-32B-Instruct-GGUF",
          "model_quant": "*-Q4_K_L.gguf"
        },
        {
          "name": "DNB large",
          "model_id": "NousResearch/Hermes-3-Llama-3.1-8B-GGUF"
