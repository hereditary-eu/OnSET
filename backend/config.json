    "yago": {
      "name": "Yago",
      "description": "YAGO knowledge base.",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_ENDPOINT:-localhost:5434}/onset-yago",
      "sparql_endpoint": "${YAGO_SPARQL_ENDPOINT:-http://localhost:9024}",
      "variants": [
        {
          "name": "Yago Mistral",
          "model_id": "bartowski/Mistral-Small-Instruct-2409-GGUF",
          "model_quant": "*-Q6_K.gguf"
        },
        {
          "name": "Yago Mistral",
          "model_id": "bartowski/Qwen2.5-Coder-32B-Instruct-GGUF",
