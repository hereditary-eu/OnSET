    "bto": {
      "name": "BTO",
      "description": "BRENDA Tissue Ontology (BTO).",
      "conn_str": "postgresql+psycopg://postgres:postgres@${ONSET_DB_HOST:-localhost:5434}/onset-bto",
      "sparql_endpoint": "${BTO_SPARQL_HOST:-http://localhost:7015}",
      "selection_distribution": "uniform",
      "variants": [
