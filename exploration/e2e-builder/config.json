{
  "default": "dbpedia",
  "defaults": {
    "model_id": "NousResearch/Hermes-3-Llama-3.2-3B-GGUF",
    "model_quant": "*Q8_0.gguf",
    "device": "cuda",
    "conn_str": "postgresql+psycopg://postgres:postgres@localhost:5434/onset",
    "sparql_endpoint": "http://localhost:7012",
    "redis_cache_url": "redis://localhost:6379/1",
    "selection_distribution": "instances"
  },
  "configs": {
    "dbpedia": {
      "name": "DBpedia (unused placeholder)",
      "description": "Required by the config file format; the e2e test only uses the builder."
    }
  },
  "builders": {
    "e2e": {
      "name": "E2E Enron mini",
      "description": "Eight short mails with variant names of the same people and companies (end-to-end test).",
      "text_set": {
        "format": "files",
        "path": "texts/mails",
        "glob": "*.txt"
      },
      "extract_instances": "${ONSET_E2E_INSTANCES:-1}",
      "save_dir": "${ONSET_E2E_SAVES:-/tmp/onset-e2e-saves}"
    }
  }
}
